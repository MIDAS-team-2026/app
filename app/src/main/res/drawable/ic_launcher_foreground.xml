<?xml version="1.0" encoding="utf-8"?>
<!-- 새싹 마크 아이콘 (I6 스펙) — viewBox 140×140 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="140"
    android:viewportHeight="140">

    <!-- 흰 원 (cx=70 cy=70 r=60) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M10,70 A60,60,0,1,0,130,70 A60,60,0,1,0,10,70 Z"/>

    <!-- 왼쪽 잎: ellipse cx=48 cy=48 rx=20 ry=30, rotate(-30, 48, 48) -->
    <group
        android:rotation="-30"
        android:pivotX="48"
        android:pivotY="48">
        <path
            android:fillColor="#7CC04A"
            android:pathData="M28,48 A20,30,0,1,0,68,48 A20,30,0,1,0,28,48 Z"/>
    </group>

    <!-- 오른쪽 잎: ellipse cx=94 cy=38 rx=22 ry=32, rotate(28, 94, 38) -->
    <group
        android:rotation="28"
        android:pivotX="94"
        android:pivotY="38">
        <path
            android:fillColor="#94C560"
            android:pathData="M72,38 A22,32,0,1,0,116,38 A22,32,0,1,0,72,38 Z"/>
    </group>

    <!-- 줄기 (M70,100 L70,60) stroke #5fa83a 8px round -->
    <path
        android:strokeColor="#5FA83A"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M70,100 L70,60"/>

</vector>
