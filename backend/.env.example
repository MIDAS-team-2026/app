# ===================================================================
# MIDAS 로컬 개발용 환경변수 양식
#
# 사용법
#   1) 이 파일을 backend/.env 로 복사한다.
#   2) 아래 값을 채운다. 따옴표(" ')는 붙이지 않는다.
#        O   DB_PASSWORD=mypassword
#        X   DB_PASSWORD="mypassword"
#   3) 프로젝트 루트에서 ./start.sh 를 실행하면 자동으로 읽는다.
#
# backend/.env 는 .gitignore 에 등록되어 있어 저장소에 올라가지 않는다.
# 이 양식 파일(.env.example)에는 실제 값을 적지 않는다.
# ===================================================================

# --- Spring 백엔드 (application.properties 가 참조) -------------------

# 로컬 MySQL(root) 비밀번호. DB 이름은 midas (jdbc:mysql://localhost:3306/midas)
DB_PASSWORD=

# AWS S3 (음성 파일 저장소)
AWS_ACCESS_KEY=
AWS_SECRET_KEY=

# --- Python AI 서버 ---------------------------------------------------

# Groq (STT: whisper-large-v3, 전사 정제 LLM).
# 값이 없으면 fastapi_ai.py 가 시작 단계에서 종료된다. https://console.groq.com
GROQ_API_KEY=

# 영남대 LLM 게이트웨이 (회상 질문·자유대화 질문 생성)
YNU_API_KEY=

# --- 아래는 기본값이 있어 보통 건드리지 않는다 ------------------------
# SPRING_BASE_URL=http://localhost:8080
# AI_PYTHON_URL=http://localhost:8000
# MIDAS_ENSEMBLE_MODEL_PATH=   (기본: backend/ai/speech_ensemble/models/ensemble.joblib)
# MIDAS_FFMPEG_PATH=ffmpeg
